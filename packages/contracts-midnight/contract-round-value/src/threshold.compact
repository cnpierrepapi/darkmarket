pragma language_version >= 0.17;

import CompactStandardLibrary;

// The entire disclosure surface of THRESHOLD.
//
// Everything the outside world is allowed to learn about a subject lives in
// these five fields. Income, obligations and account history are circuit
// inputs, and none of them are written here. A sync node reading Midnight's
// public ledger sees a tier and a date. That is the point of the build.
export ledger round: Counter;
export ledger subject: Bytes<64>;
export ledger tier: Uint<8>;
export ledger valid_until: Uint<64>;
export ledger policy_version: Uint<16>;

// Tier 2 wants twice the payment covered and a seasoned account.
// Tier 1 wants the payment covered.
// Tier 0 is everyone else.
export circuit attest(
  subject_: Bytes<64>,
  monthly_income_: Uint<64>,
  monthly_obligations_: Uint<64>,
  months_history_: Uint<8>,
  required_payment_: Uint<64>,
  valid_until_: Uint<64>,
): [] {
  // Unsigned subtraction aborts at runtime when it would go negative, so the
  // over-committed case has to be caught before the subtraction, not after.
  const headroom = (monthly_income_ > monthly_obligations_
    ? monthly_income_ - monthly_obligations_
    : 0) as Uint<64>;

  const covers_once = headroom >= required_payment_;
  const covers_twice = headroom >= required_payment_ * 2;
  const seasoned = months_history_ >= 12;

  const computed_tier = covers_twice && seasoned ? 2 : (covers_once ? 1 : 0);

  round.increment(1);
  subject = disclose(subject_);
  tier = disclose(computed_tier) as Uint<8>;
  valid_until = disclose(valid_until_);
  policy_version = 1;
}
