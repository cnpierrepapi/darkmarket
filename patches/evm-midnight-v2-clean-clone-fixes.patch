diff --git a/templates/evm-midnight-v2/Dockerfile b/templates/evm-midnight-v2/Dockerfile
index 6b72dff..a27de30 100644
--- a/templates/evm-midnight-v2/Dockerfile
+++ b/templates/evm-midnight-v2/Dockerfile
@@ -35,6 +35,9 @@ RUN curl --proto '=https' --tlsv1.2 -LsSf https://github.com/midnightntwrk/compa
 ENV PATH="/root/.local/bin:$PATH"
 RUN which compact
 RUN compact update 0.31.0
+# The contract script compiles with `compact compile +0.33.0-rc.2`, so that toolchain
+# must be present too or build:midnight fails with "Couldn't find compiler".
+RUN compact update 0.34.0
 RUN compact --version
 RUN compact compile --version
 
@@ -55,6 +58,11 @@ RUN mkdir -p /root/.cache/hardhat-nodejs/compilers-v3/wasm && \
       chmod +x /root/.cache/hardhat-nodejs/compilers-v3/linux-amd64/solc-linux-amd64-v0.8.30+commit.73712a01; \
     fi
 
+# The npm-wrapped Midnight proof-server binary is Nix-built: its ELF interpreter is
+# hardcoded to a /nix/store glibc path absent on Debian, so posix_spawn fails with
+# ENOENT on a binary that is present. Point that path at Debian's own loader.
+RUN mkdir -p /nix/store/jms7zxzm7w1whczwny5m3gkgdjghmi2r-glibc-2.42-51/lib     && ln -sf /lib64/ld-linux-x86-64.so.2        /nix/store/jms7zxzm7w1whczwny5m3gkgdjghmi2r-glibc-2.42-51/lib/ld-linux-x86-64.so.2
+
 WORKDIR /app
 
 COPY . .
